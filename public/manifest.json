{
  "manifest_version": 3,
  "name": "Tarka AI Browser Agent",
  "version": "1.1.0",
  "description": "Autonomous AI Browser Agent for Local & Cloud LLMs (Ollama, OpenRouter, Gemini, OpenAI, Claude, NVIDIA NIM, and custom APIs).",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "tabGroups",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tarka AI Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/domCompressor.js",
        "content/actionExecutor.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/frameAgent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
