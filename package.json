{
  "name": "tarka-ai-browser-agent",
  "version": "1.1.0",
  "private": true,
  "description": "Autonomous AI Browser Agent for Local & Cloud LLMs (Ollama, OpenRouter, Gemini, OpenAI, Claude, NVIDIA NIM, and custom APIs).",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "check:tests": "node scripts/checkTestCount.mjs",
    "quality": "node scripts/quality.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/content && tsc --noEmit -p tests",
    "test:e2e": "node tests/e2e/smoke.mjs --build",
    "click-lab": "node tests/e2e/click-lab.mjs",
    "test:replay": "node tests/e2e/replay-real.mjs",
    "check": "for f in content/*.js sidepanel/*.js; do node --check \"$f\" || exit 1; done",
    "build": "node scripts/build.mjs",
    "evalscan": "node scripts/evalscan.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "author": "Prit Dhanani (preetdhanani)",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.4",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "parse5": "8.0.1"
  }
}
